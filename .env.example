OLLAMA_EMBEDDINGS_MODEL=qwen3-embedding:8b
OLLAMA_BASE_URL=http://localhost:11434

ADMIN_SERVER_URL=http://administrator-server:8000
ADMIN_SERVER_TOKEN=admin-token
